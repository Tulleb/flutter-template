# Shared Fastfile of the Flutter template (symlinked into each project as fastlane/Fastfile).
#
# Store texts are versioned in fastlane/metadata and pushed with these lanes; scripts/release.sh
# calls them (validate_metadata before the builds, `ios metadata` and `android upload` after
# them). Run them by hand through Bundler from the project root, e.g.
# `bundle exec fastlane ios metadata`.
#
# Only the files that exist are pushed, so a project picks what it versions:
# - Release notes only: fastlane/metadata/ios/<locale>/release_notes.txt (App Store "What's New",
#   4000 characters) and fastlane/metadata/android/<locale>/changelogs/default.txt (Google Play,
#   500 characters; changelogs/<build number>.txt overrides it for one build). The listings stay
#   managed in App Store Connect and Play Console.
# - Full listings: add name.txt, subtitle.txt, description.txt… (iOS) or title.txt,
#   short_description.txt, full_description.txt, images/… (Android), and iOS screenshots in
#   fastlane/screenshots/ios/<locale>.
# Release notes are written by scripts/write-changelog.py when the release needs new ones (see
# scripts/changelog-format.md).
#
# Credentials come from the environment (scripts/release.sh loads them from .secret.local, see
# .secret.local.example):
# - APP_STORE_CONNECT_API_KEY, APP_STORE_CONNECT_APP_ISSUER_ID: the App Store Connect API key id
#   and issuer id, as used by `xcrun altool`. The key file is looked up where altool looks for it,
#   unless APP_STORE_CONNECT_API_KEY_PATH points to it.
# - PLAY_STORE_JSON_KEY_PATH: a Google Play service account JSON key with release rights.
#
# Ruby code in this file runs from the fastlane folder, while action paths are relative to the
# project root.

skip_docs
default_platform(:ios)

IOS_METADATA = "fastlane/metadata/ios"
IOS_SCREENSHOTS = "fastlane/screenshots/ios"
ANDROID_METADATA = "fastlane/metadata/android"
ANDROID_BUNDLE = "build/app/outputs/bundle/release/app-release.aab"

# Store limits, in characters, checked before anything is built or uploaded.
LIMITS = {
  "metadata/ios/*/name.txt" => 30,
  "metadata/ios/*/subtitle.txt" => 30,
  "metadata/ios/*/keywords.txt" => 100,
  "metadata/ios/*/promotional_text.txt" => 170,
  "metadata/ios/*/description.txt" => 4000,
  "metadata/ios/*/release_notes.txt" => 4000,
  "metadata/android/*/title.txt" => 30,
  "metadata/android/*/short_description.txt" => 80,
  "metadata/android/*/full_description.txt" => 4000,
  "metadata/android/*/changelogs/*.txt" => 500,
}.freeze

# Files that the stores refuse empty.
NON_EMPTY = ["metadata/ios/*/release_notes.txt", "metadata/android/*/changelogs/*.txt"].freeze

# The app version from pubspec.yaml, such as `{ name: "1.2.3", build: 45 }`.
def pubspec_version
  version = File.read("../pubspec.yaml")[/^version:\s*(\S+)/, 1]
  name, build = version.to_s.split("+")
  UI.user_error!("pubspec.yaml needs a version with a build number, such as 1.2.3+45") unless name && build
  { name: name, build: build.to_i }
end

# The version the builds were uploaded with. scripts/release.sh drops a ".0" patch (pubspec.yaml
# 1.3.0 ships as 1.3) and tags the release `<version>+<build>` before the uploads, so the tag on
# HEAD gives it; without one, the same rule applies to pubspec.yaml.
def store_version
  version = pubspec_version
  tag = sh("git", "tag", "--points-at", "HEAD", log: false).split("\n").map(&:strip)
    .find { |name| name.end_with?("+#{version[:build]}") }
  return tag.delete_suffix("+#{version[:build]}") if tag
  version[:name].sub(/^(\d+\.\d+)\.0$/, '\1')
end

# Whether a glob relative to the fastlane folder matches any file.
def any_file?(pattern)
  !Dir.glob(pattern).empty?
end

desc "Check the store texts against the stores' length limits"
lane :validate_metadata do
  errors = LIMITS.flat_map do |pattern, limit|
    Dir.glob(pattern).filter_map do |path|
      length = File.read(path).strip.length
      if length.zero? && NON_EMPTY.any? { |p| File.fnmatch(p, path) }
        "#{path} is empty"
      elsif length > limit
        "#{path}: #{length} characters, the limit is #{limit}"
      end
    end
  end
  UI.user_error!("Store texts not valid:\n#{errors.join("\n")}") unless errors.empty?
  UI.success("Store texts fit the stores' limits.")
end

platform :ios do
  private_lane :authenticate do
    key_id = ENV.fetch("APP_STORE_CONNECT_API_KEY") { UI.user_error!("APP_STORE_CONNECT_API_KEY is not set") }
    key_path = ENV["APP_STORE_CONNECT_API_KEY_PATH"].to_s.strip
    key_path = if key_path.empty?
      ["~/.appstoreconnect/private_keys", "~/.private_keys", "~/private_keys", "../private_keys"]
        .map { |dir| File.expand_path("#{dir}/AuthKey_#{key_id}.p8") }
        .find { |path| File.exist?(path) }
    else
      File.expand_path(key_path, "..")
    end
    UI.user_error!("App Store Connect API key file not found, set APP_STORE_CONNECT_API_KEY_PATH") unless key_path && File.exist?(key_path)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV.fetch("APP_STORE_CONNECT_APP_ISSUER_ID") { UI.user_error!("APP_STORE_CONNECT_APP_ISSUER_ID is not set") },
      key_filepath: key_path,
    )
  end

  desc "Push the App Store texts (release notes, and the listing when versioned) and screenshots"
  desc "for the version being released. Creates the version if needed; never uploads a build nor"
  desc "submits for review"
  lane :metadata do
    validate_metadata
    UI.user_error!("No App Store texts in #{IOS_METADATA}") unless any_file?("metadata/ios/**/*.txt")
    screenshots = any_file?("screenshots/ios/*/*.{png,jpg,jpeg}")
    # sync_screenshots is still a beta option in deliver and refuses to run without this flag.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "1" if screenshots
    upload_to_app_store(
      # Passed explicitly: fastlane would otherwise read the key id in APP_STORE_CONNECT_API_KEY
      # as this option, and fail.
      api_key: authenticate,
      app_version: store_version,
      # Only the fields with a file are changed: the others are left as they are.
      metadata_path: IOS_METADATA,
      screenshots_path: IOS_SCREENSHOTS,
      skip_screenshots: !screenshots,
      # Compares checksums with App Store Connect: only changed or new screenshots are uploaded,
      # and only the ones gone from fastlane/screenshots are deleted.
      sync_screenshots: screenshots,
      skip_binary_upload: true,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      force: true,
    )
  end
end

platform :android do
  private_lane :play_options do
    json_key = ENV.fetch("PLAY_STORE_JSON_KEY_PATH") { UI.user_error!("PLAY_STORE_JSON_KEY_PATH is not set") }
    UI.user_error!("Google Play key not found at #{json_key}") unless File.exist?(File.expand_path(json_key, ".."))
    {
      json_key: File.expand_path(json_key, ".."),
      metadata_path: ANDROID_METADATA,
      # The listing texts and images are pushed only when the project versions them.
      skip_upload_metadata: !any_file?("metadata/android/*/{title,short_description,full_description}.txt"),
      skip_upload_images: !any_file?("metadata/android/*/images/*.{png,jpg,jpeg}"),
      skip_upload_screenshots: !any_file?("metadata/android/*/images/*Screenshots/*.{png,jpg,jpeg}"),
    }
  end

  desc "Push the Google Play listing texts and images, without any release"
  lane :metadata do
    validate_metadata
    upload_to_play_store(
      **play_options,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_changelogs: true,
    )
  end

  desc "Upload the release app bundle as a draft on the internal testing track, with its release"
  desc "notes (changelogs/<build number>.txt, or changelogs/default.txt) and the listing when versioned"
  lane :upload do
    validate_metadata
    UI.user_error!("No app bundle at #{ANDROID_BUNDLE}, run `flutter build appbundle` first") unless File.exist?("../#{ANDROID_BUNDLE}")
    upload_to_play_store(
      **play_options,
      aab: ANDROID_BUNDLE,
      track: "internal",
      release_status: "draft",
      version_name: "#{store_version} (#{pubspec_version[:build]})",
    )
  end
end
