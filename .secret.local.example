# Copy to .secret.local (never committed). Read by scripts/release.sh and the Fastlane lanes.

# App Store Connect API key id and issuer id (xcrun altool and `fastlane ios metadata`).
APP_STORE_CONNECT_API_KEY=
APP_STORE_CONNECT_APP_ISSUER_ID=
# Optional: the AuthKey_<key id>.p8 file, when it is not where altool looks for it
# (~/.appstoreconnect/private_keys, ~/.private_keys, ~/private_keys or ./private_keys).
APP_STORE_CONNECT_API_KEY_PATH=

# Google Play service account JSON key path (`fastlane android ...`). Keep the file outside
# the repo. Generate it as follows:
# 1. Play Console → Setup → API access → link a Google Cloud project.
# 2. Create (or pick) a service account, then Grant access in Play Console with release
#    rights (e.g. "Release apps to testing tracks" / production as needed).
# 3. Google Cloud Console → IAM & Admin → Service Accounts → that account → Keys →
#    Add key → Create new key → JSON. Save the downloaded file somewhere local.
# 4. Set this var to the absolute path of that .json file.
PLAY_STORE_JSON_KEY_PATH=
