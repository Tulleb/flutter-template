# Copy to .secret.local (never committed). Read by scripts/release.sh and the Fastlane lanes.

# App Store Connect API key id and issuer id (xcrun altool and `fastlane ios metadata`).
# Native iOS projects may use APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID
# and APP_STORE_CONNECT_API_KEY_KEY_FILEPATH instead.
APP_STORE_CONNECT_API_KEY=
APP_STORE_CONNECT_APP_ISSUER_ID=
# Optional: path to AuthKey_<APP_STORE_CONNECT_API_KEY>.p8 when it is not in altool's
# default dirs (~/.appstoreconnect/private_keys, ~/.private_keys, ~/private_keys, ./private_keys).
# Filename Key ID must match APP_STORE_CONNECT_API_KEY. Prefer an absolute path (no ~).
APP_STORE_CONNECT_API_KEY_PATH=

# Google Play service account JSON key (`fastlane android upload`, run by scripts/release.sh).
# Keep the file outside the repo and set its absolute path below (no ~). Without a valid key,
# release.sh offers a manual upload: the AAB in Finder and the release notes on the clipboard.
#
# How to generate the key and its file (once per app):
# 1. Google Cloud Console (https://console.cloud.google.com): select or create the app's project,
#    then APIs & Services → Library → enable "Google Play Android Developer API".
# 2. IAM & Admin → Service Accounts → Create service account (e.g. "fastlane"); skip the optional
#    role step.
# 3. Open the service account → Keys → Add key → Create new key → JSON: a .json file is downloaded.
# 4. Google Play Console (https://play.google.com/console) → Users and permissions → Invite new
#    users → enter the service account's email (…@….iam.gserviceaccount.com) → App permissions:
#    add the app with "View app information", "Release to testing tracks" and "Manage store
#    presence" → send the invitation.
# 5. Move the key outside the repo and restrict its access:
#      mkdir -p ~/.googleplay
#      mv ~/Downloads/<key>.json ~/.googleplay/<app>-play.json
#      chmod 600 ~/.googleplay/<app>-play.json
# 6. Put its absolute path below (e.g. /Users/<you>/.googleplay/<app>-play.json), then check it
#    (permissions can take a few minutes to apply):
#      bundle exec fastlane run validate_play_store_json_key json_key:/Users/<you>/.googleplay/<app>-play.json
# The app must already exist in Play Console, with a first bundle uploaded by hand (e.g. to
# internal testing), before Fastlane can upload to it.
PLAY_STORE_JSON_KEY_PATH=

# AI release notes (scripts/write-changelog.py, run by release.sh when the notes of the version
# being released are missing). OpenAI API key and the model that writes the notes. Without them,
# release.sh asks to keep the current notes or stop so you can write them by hand.
OPENAI_API_KEY=
CHANGELOG_MODEL=gpt-6.1-sol
# Optional: more path prefixes kept out of the diffs the model reads, and related repositories
# (relative paths) whose commit messages count too, both comma-separated. May sit in .env.
CHANGELOG_SKIP_PATHS=
CHANGELOG_EXTRA_REPOS=
