# Copy to .secret.local (never committed). Read by scripts/release.sh and the Fastlane lanes.

# App Store Connect API key id and issuer id (xcrun altool and `fastlane ios metadata`).
# Native iOS projects may use APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID
# and APP_STORE_CONNECT_API_KEY_KEY_FILEPATH instead.
APP_STORE_CONNECT_API_KEY=
APP_STORE_CONNECT_APP_ISSUER_ID=
# Optional: path to AuthKey_<APP_STORE_CONNECT_API_KEY>.p8 when it is not in altool's
# default dirs (~/.appstoreconnect/private_keys, ~/.private_keys, ~/private_keys, ./private_keys).
# Filename Key ID must match APP_STORE_CONNECT_API_KEY. Prefer an absolute path (no ~).
APP_STORE_CONNECT_API_KEY_PATH=

# Google Play service account JSON key path (`fastlane android ...`). Keep the file outside
# the repo. See the Flutter Template repo README → "Google Play service account key" for how to generate it.
# If missing/invalid, or if Fastlane upload fails, release.sh offers a manual AAB upload via Finder.
PLAY_STORE_JSON_KEY_PATH=

# AI release notes (scripts/write-changelog.py, run by release.sh when the notes of the version
# being released are missing). OpenAI API key and the model that writes the notes. Without them,
# release.sh asks to keep the current notes or stop so you can write them by hand.
OPENAI_API_KEY=
CHANGELOG_MODEL=gpt-6.1-sol
# Optional: more path prefixes kept out of the diffs the model reads, and related repositories
# (relative paths) whose commit messages count too, both comma-separated. May sit in .env.
CHANGELOG_SKIP_PATHS=
CHANGELOG_EXTRA_REPOS=
